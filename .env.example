# Local development configuration. Copy to .env and set your own password.
#
#   cp .env.example .env
#
# .env is gitignored. Deployed environments do not use this file: Terraform
# provisions the Supabase project and passes DATABASE_URL to the container app
# as a secret, see iac/README.md.

# Credentials for the local Postgres container in src/financial_data_agent/db/docker-compose.yaml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=financial_data_agent

# Read by db/database.py and migrations/env.py. Must match the three values above.
# Use host.docker.internal instead of localhost when connecting from a container.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/financial_data_agent
