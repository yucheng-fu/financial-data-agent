{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Filings Backfill",
            "type": "debugpy",
            "request": "launch",
            "module": "ollama_rag.backend.filings",
            "console": "integratedTerminal",
            "args": [
                "--start-year",
                "2022",
                "--end-year",
                "2025",
                "--quarters",
                "1",
                "2",
                "3",
                "4",
                "--limit",
                "5",
                "--max-period-workers",
                "4",
                "--max-symbol-workers",
                "5"
            ]
        }
    ]
}
